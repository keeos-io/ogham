LIB_DIR ?= ../lib

# Ogham firmware — SWAPPED-A/B ENCODER variant.
#
# You almost certainly do not want this. The normal `make` is the build for
# every Ogham that has been distributed; this variant exists for a handful of
# in-house development units fitted with an encoder batch whose A/B phase is
# reversed, and it is not published as a binary.
#
# WATCH THE DIRECTION: this file was Makefile.encorig before v1.18 and forced
# ENC_REVERSED=0. Since v1.18 the MAIN build passes 0, because that is what the
# standard part needs. What is left over is the swapped batch, which this passes
# 1 for. The source of truth is the `#define ENC_REVERSED` default in
# src/ogham_controls.cpp -- not this filename, and not an older release note.
#
# Identical to the normal build in every other respect.
#
# Build (own object dir so the differing flag can't collide with the normal build):
#   make -f Makefile.encswap BUILD_DIR=build_encswap -j8
# Flash:
#   dfu-util -a 0 -s 0x08000000:leave -D build_encswap/ogham_bytebeat_encswap.bin
#
# Reverting a unit either way = flash the other build.
TARGET = ogham_bytebeat_encswap
C_DEFS = -DENC_REVERSED=1

CPP_SOURCES = \
	src/ogham_main.cpp \
	src/ogham_controls.cpp \
	src/ogham_audio_pipeline.cpp \
	src/ogham_cv_output.cpp \
	src/ogham_display.cpp \
	src/tm1637.cpp \
	src/bytebeat_engine.cpp \
	src/formulas.cpp \
	src/bpm_clock.cpp

LIBDAISY_DIR = $(LIB_DIR)/libDaisy
DAISYSP_DIR  = $(LIB_DIR)/DaisySP

C_INCLUDES += -Isrc

SYSTEM_FILES_DIR = $(LIBDAISY_DIR)/core
include $(SYSTEM_FILES_DIR)/Makefile
