	(text "CLOCK / V-OCT MODE SWITCH\nSPDT toggle (Dailywell 2MS1T1B1M2QES)\nCommon (pad 2) -> GND; pad 1 -> MODE_SW -> D8 (pin 9), read INPUT_PULLUP\nSelects Clock/tempo vs V/oct pitch, and the Rate pot's role"
		(exclude_from_sim no)
		(at 215.9 99.568 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1ab7af7a-f734-400f-a687-802a30081bfa")
	)
	(text "Output Jacks (mono): \nOUT1, OUT2, CV OUT, GATE OUT (plain, unswitched)"
		(exclude_from_sim no)
		(at 108.712 133.35 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "4fc4112a-bba3-4a04-9e77-a8c08a266055")
	)
	(text "Input Jacks (mono): CV A, CV B, CLK / V-OCT, GATE IN\nSwitched-T type - tip normalled to GND when unpatched."
		(exclude_from_sim no)
		(at 23.114 132.588 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "5e54a206-35d5-4311-a885-b7f96222d1a9")
	)
	(text "Pot A"
		(exclude_from_sim no)
		(at 29.464 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b5000000-0000-0000-0000-000000000a01")
	)
	(text "Rotary encoder - 100nF to GND on A/B/SW\nMCU internal pull-ups enabled in firmware (~4ms RC with ~40k pull-up)\nEncoder + display GPIO connect directly to Daisy Seed digital pins"
		(exclude_from_sim no)
		(at 23.368 78.232 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "b5000000-0000-0000-0000-000000000b01")
	)
	(text "TM1637 Display Module (4-pin connector)\nPinout: 1=CLK, 2=DIO, 3=GND, 4=+5V. Powered from +5V;\nR_dio1 (10k) pulls DIO to +3V3. CLK has no pull-up.\nFirmware requires ~50us bus bit timing - 5us will not latch."
		(exclude_from_sim no)
		(at 113.03 78.232 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "b5000000-0000-0000-0000-000000000c01")
	)
	(text "USER INTERFACE\nPotentiometers | Rotary Encoder | Mode Switch | TM1637 Display Module"
		(exclude_from_sim no)
		(at 16.002 23.368 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "b5000000-0000-0000-0001-000000000001")
	)
	(text "Potentiometers with ADC RC Filters\nADC RC filter: R_flt (1k) + C_flt (100nF) = 1.59kHz\nR_pd1-4 (100k) to GND: defines 0V if a wiper opens. 100k (was 10k) -\nthe lighter load recovers ~8% of ADC range."
		(exclude_from_sim no)
		(at 180.34 24.638 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "b5000001-0000-0000-0000-000000000001")
	)
	(text "Pot B"
		(exclude_from_sim no)
		(at 91.186 31.242 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b5000002-0000-0000-0000-000000000001")
	)
	(text "Pot 3 - Rate\nDual role: tempo trim in Clock mode,\nbipolar +/-1 octave fine tune in V/oct mode."
		(exclude_from_sim no)
		(at 154.94 33.782 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b5000003-0000-0000-0000-000000000001")
	)
	(text "Pot 4 - Tone (Lo-Fi macro)"
