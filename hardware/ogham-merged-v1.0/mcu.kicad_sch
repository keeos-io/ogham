		(uuid "4bcfa9a6-4bc5-4ece-b84c-cc19b7309e86")
	)
	(text "Daisy Seed Module — STM32H750 + PCM3060 stereo codec\nAudio OUT on pins 18/19; codec inputs (16/17) unused\nADC on pins 22-28; DAC1 on pin 30 (DAC2 / pin 29 spare)"
		(exclude_from_sim no)
		(at 137.16 42.418 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left)
		)
		(uuid "e1000001-0001-0001-0001-000000000001")
	)
	(text "GPIO Pin Assignments:\n  D0 (pin 1) = ENC_A        D5 (pin 6) = GATE_IN\n  D1 (pin 2) = ENC_B        D6 (pin 7) = CLK_IN\n  D2 (pin 3) = ENC_SW       D7 (pin 8) = GATE_OUT\n  D8 (pin 9) = MODE_SW      D9 (pin 10) = TM1637_CLK\n  D10 (pin 11) = TM1637_DIO\n\nADC Pin Assignments:\n  D15/A0 (pin 22) = POT_A      D19/A4 (pin 26) = CV_A\n  D16/A1 (pin 23) = POT_B      D20/A5 (pin 27) = CV_B\n  D17/A2 (pin 24) = POT_RATE   D21/A6 (pin 28) = VOCT_ADC\n  D18/A3 (pin 25) = POT_TONE   D23/DAC1 (pin 30) = CV_OUT_DAC\n\nSpare: pins 4, 5, 12-15, 31-37 (no-connect)"
		(exclude_from_sim no)
		(at 195.834 141.478 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "e1000002-0001-0001-0001-000000000001")
	)
	(text "Seed has onboard BOOT + RESET buttons, USB-C, 3V3 buck,\nand 8MB QSPI flash (formula + FX settings persistence)"
