	(text "R_OUT1/R_OUT2 (1k): series output protection.\nOutputs are DC-coupled."
		(exclude_from_sim no)
		(at 169.164 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "235a218f-1d7d-4a50-b9b5-93e2107298bf")
	)
	(text "Audio from Daisy Seed PCM3060 codec (stereo, AC-coupled at the Seed)"
		(exclude_from_sim no)
		(at 129.54 55.626 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "3d000001-0001-0001-0001-000000000001")
	)
	(text "TL072 non-inverting gain stages (U7A / U7B), powered from +/-12V\nGain = 1 + 10k/2.7k = 4.7x\nNote: U7A uses R_F2+R_G1; U7B uses R_F1+R_G2"
		(exclude_from_sim no)
		(at 130.302 88.9 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "3d000002-0001-0001-0001-000000000001")
	)
	(text "Output level: full-scale ~19.5Vpp measured (~2x hot).\nCodec is ~4Vpp (not the ~2Vpp assumed); firmware trims to ~10Vpp for now.\nNext rev: halve gain (R_G 2.7k->6.8k or R_F 10k->3.9k) for ~10Vpp."
		(exclude_from_sim no)
		(at 130.302 98 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left top)
		)
		(uuid "3d0000a0-0001-0001-0001-0000000000a1")
	)
	(text "Reconstruction filter: R_FILT 470R + C_FILT 2.2nF\nfc ~154kHz (anti-imaging, ahead of the gain stage)"
		(exclude_from_sim no)
		(at 70.866 119.888 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "3d000003-0001-0001-0001-000000000001")
	)
	(text "R8/R9 (100k) to GND: DC bias reference for the TL072 + inputs.\nREQUIRED - the Seed's codec outputs are AC-coupled with no DC path.\nSets 0V bias, ~0.7Hz HP with the Seed coupling cap."
		(exclude_from_sim no)
		(at 73.152 191.516 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c404ad83-8b9b-49c2-8206-c506168edc6f")
	)
	(text "C_TL1/C_TL2 (100nF): U7 +/-12V decoupling"
